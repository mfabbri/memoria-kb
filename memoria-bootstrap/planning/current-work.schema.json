{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria.local/schemas/current-work.schema.json",
  "title": "Me.Mo.Ri.A current work state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "selected_at",
    "roadmap_basis",
    "increment",
    "verification",
    "next_action"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "status": {
      "enum": ["uninitialized", "selected", "in_progress", "blocked", "completed", "superseded"]
    },
    "selected_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "roadmap_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "section"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "increment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "title", "objective", "scope", "out_of_scope", "candidate_files", "stop_condition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "candidate_files": { "type": "array", "items": { "type": "string" } },
        "stop_condition": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "documentation_touchpoints", "result"],
      "properties": {
        "tests": { "type": "array", "items": { "type": "string" } },
        "documentation_touchpoints": { "type": "array", "items": { "type": "string" } },
        "result": { "enum": ["pending", "not_run", "passed", "failed", "partial", "not_applicable"] },
        "notes": { "type": "string" },
        "task_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "repositories", "read_set", "write_set", "test_command", "stop_conditions"],
          "properties": {
            "mode": { "enum": ["discovery-lite", "scoped-fix", "feature-slice", "quality-slice", "architecture-review"] },
            "repositories": { "type": "array", "items": { "type": "string" } },
            "read_set": { "type": "array", "items": { "type": "string" } },
            "write_set": { "type": "array", "items": { "type": "string" } },
            "test_command": { "type": "string" },
            "stop_conditions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "session_notes": { "type": "array", "items": { "type": "string" } },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "description"],
      "properties": {
        "mode": { "enum": ["resume", "recalculate", "review", "none"] },
        "description": { "type": "string" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "tier", "task_class", "agent", "model", "reasoning_effort", "rationale", "trace"],
      "properties": {
        "policy_version": { "const": "2.0" },
        "tier": { "enum": ["low", "medium", "review", "high"] },
        "task_class": { "enum": ["discovery", "documentation", "implementation", "quality", "architecture", "migration"] },
        "agent": { "enum": ["scanner", "docs_reviewer", "docs_editor", "implementer", "test_reviewer", "architect"] },
        "model": { "enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"] },
        "reasoning_effort": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 1 },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "tier", "agent", "model", "reasoning_effort", "reason"],
            "properties": {
              "at": { "type": ["string", "null"], "format": "date-time" },
              "event": { "enum": ["selected", "delegated", "escalated", "fallback"] },
              "tier": { "enum": ["low", "medium", "review", "high"] },
              "agent": { "enum": ["scanner", "docs_reviewer", "docs_editor", "implementer", "test_reviewer", "architect"] },
              "model": { "enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"] },
              "reasoning_effort": { "enum": ["low", "medium", "high"] },
              "reason": { "type": "string", "minLength": 1 },
              "from_tier": { "type": ["string", "null"], "enum": ["low", "medium", "review", "high", null] }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["selected", "in_progress", "blocked"] } } },
      "then": { "required": ["routing"] }
    }
  ]
}
